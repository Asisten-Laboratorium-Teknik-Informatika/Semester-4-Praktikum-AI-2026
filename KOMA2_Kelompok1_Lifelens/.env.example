# ═══════════════════════════════════════════════════════════════
# LifeLens — Environment Variables
# Copy file ini ke .env dan isi dengan nilai asli
# ═══════════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_KEY=eyJxxx...

# ─── Gemini API ───────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyxxx...
# Key cadangan (rotasi lintas project Google Cloud)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ─── Enkripsi (AES-256 Fernet) ────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Redis (opsional untuk MVP, pakai in-memory) ─────────────
REDIS_URL=

# ─── App ──────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend (prefix VITE_ agar diakses oleh Vite) ──────────
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx...
VITE_WS_URL=ws://localhost:8000
VITE_API_URL=http://localhost:8000

# Konfigurasi respon Gemini
LIFELENS_GEMINI_SHORT_PROMPT=0
LIFELENS_GEMINI_MAX_OUTPUT_TOKENS=512
